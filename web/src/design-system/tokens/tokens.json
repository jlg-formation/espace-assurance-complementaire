{
  "$description": "Clarea Assurances, piste A « posée et claire » (docs/08-design-system/02-identite.md). Primitifs d'abord, puis sémantiques qui ne font que les référencer.",
  "color": {
    "white": { "$type": "color", "$value": "#ffffff" },
    "petrol": {
      "$type": "color",
      "50": { "$value": "#e8f4f5" },
      "100": { "$value": "#c9e4e6" },
      "700": { "$value": "#0b5f66" },
      "900": { "$value": "#073f44" }
    },
    "blue": {
      "$type": "color",
      "50": { "$value": "#eaf3fa" },
      "700": { "$value": "#0b4f80" }
    },
    "gray": {
      "$type": "color",
      "50": { "$value": "#f4f7f8" },
      "100": { "$value": "#e6eaed" },
      "300": { "$value": "#c3cad0" },
      "500": { "$value": "#7a8691" },
      "700": { "$value": "#4a5560" },
      "900": { "$value": "#1b2328" },
      "900-overlay": { "$value": "#1b2328b3", "$description": "Gris 900 à 70 % d'opacité" }
    },
    "red": {
      "$type": "color",
      "50": { "$value": "#fdeeee" },
      "700": { "$value": "#b3261e" }
    },
    "green": {
      "$type": "color",
      "50": { "$value": "#ebf7ef" },
      "700": { "$value": "#1e6b3a" }
    },
    "orange": {
      "$type": "color",
      "50": { "$value": "#fff4e5" },
      "800": { "$value": "#8a4b00" }
    },
    "text": {
      "$type": "color",
      "default": { "$value": "{color.gray.900}", "$description": "Texte courant" },
      "muted": { "$value": "{color.gray.700}", "$description": "Texte secondaire, aides" },
      "inverse": { "$value": "{color.white}", "$description": "Texte sur fond foncé" },
      "link": { "$value": "{color.petrol.700}", "$description": "Liens" },
      "error": { "$value": "{color.red.700}", "$description": "Message d'erreur de champ" },
      "success": { "$value": "{color.green.700}", "$description": "Confirmation courte" }
    },
    "background": {
      "$type": "color",
      "default": { "$value": "{color.white}", "$description": "Fond de page" },
      "subtle": { "$value": "{color.gray.50}", "$description": "Fond de bloc, de pied de page" },
      "accent": { "$value": "{color.petrol.50}", "$description": "Fond du chiffre décisif (ligne total), carte survolée, onglet courant" },
      "inverse": { "$value": "{color.gray.900}", "$description": "Fond foncé" },
      "overlay": { "$value": "{color.gray.900-overlay}", "$description": "Voile derrière une modale" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{color.gray.300}", "$description": "Filets, séparateurs (décoratifs)" },
      "strong": { "$value": "{color.gray.500}", "$description": "Bordure de champ (contraste 3:1)" },
      "focus": { "$value": "{color.petrol.700}", "$description": "Indicateur de focus" },
      "accent": { "$value": "{color.petrol.700}", "$description": "Filet de la rubrique courante, de la ligne total" }
    },
    "action": {
      "$type": "color",
      "primary": { "$value": "{color.petrol.700}", "$description": "Fond du bouton principal" },
      "primary-hover": { "$value": "{color.petrol.900}", "$description": "Fond du bouton principal au survol" },
      "primary-text": { "$value": "{color.white}", "$description": "Texte du bouton principal" },
      "secondary-text": { "$value": "{color.petrol.700}", "$description": "Texte du bouton secondaire" },
      "secondary-border": { "$value": "{color.petrol.700}", "$description": "Bordure du bouton secondaire" },
      "secondary-hover": { "$value": "{color.petrol.50}", "$description": "Fond du bouton secondaire au survol" },
      "disabled": { "$value": "{color.gray.100}", "$description": "Fond d'une action désactivée" },
      "disabled-text": { "$value": "{color.gray.700}", "$description": "Texte d'une action désactivée" }
    },
    "feedback": {
      "$type": "color",
      "error": {
        "text": { "$value": "{color.red.700}" },
        "background": { "$value": "{color.red.50}" },
        "border": { "$value": "{color.red.700}" }
      },
      "success": {
        "text": { "$value": "{color.green.700}" },
        "background": { "$value": "{color.green.50}" },
        "border": { "$value": "{color.green.700}" }
      },
      "warning": {
        "text": { "$value": "{color.orange.800}" },
        "background": { "$value": "{color.orange.50}" },
        "border": { "$value": "{color.orange.800}" }
      },
      "info": {
        "text": { "$value": "{color.blue.700}" },
        "background": { "$value": "{color.blue.50}" },
        "border": { "$value": "{color.blue.700}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Segoe UI", "system-ui", "-apple-system", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "heading": { "$value": "{font.family.base}" }
    },
    "size": {
      "$type": "dimension",
      "s": { "$value": "0.875rem" },
      "m": { "$value": "1rem" },
      "l": { "$value": "1.25rem" },
      "xl": { "$value": "1.5625rem" },
      "xxl": { "$value": "1.9375rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "base": { "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "full": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": "44px", "$description": "Cible tactile minimale" },
    "focus-ring": { "$value": "3px", "$description": "Épaisseur de l'indicateur de focus" },
    "accent-bar": { "$value": "6px", "$description": "Filet gauche des alertes et de la ligne total" },
    "tab-bar": { "$value": "4.5rem", "$description": "Hauteur réservée sous le contenu pour la barre d'onglets mobile" },
    "content": { "$value": "72rem", "$description": "Largeur maximale du contenu" },
    "card-min": { "$value": "16rem", "$description": "Largeur minimale d'une carte dans une grille" },
    "dialog": { "$value": "32rem", "$description": "Largeur maximale d'une modale" },
    "placeholder": { "$value": "8rem", "$description": "Hauteur d'une image de remplacement" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "100ms" },
    "base": { "$value": "200ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "tablet": { "$value": "768px", "$description": "Écrit en dur dans les requêtes média des CSS de composants" },
    "desktop": { "$value": "1024px", "$description": "Écrit en dur dans les requêtes média des CSS de composants" }
  }
}
