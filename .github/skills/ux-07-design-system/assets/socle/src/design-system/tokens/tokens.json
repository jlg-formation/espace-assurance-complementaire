{
  "$description": "Modèle ux-07 : valeurs d'exemple, à remplacer par celles de la piste retenue. Primitifs d'abord, puis sémantiques qui ne font que les référencer.",
  "color": {
    "white": { "$type": "color", "$value": "#ffffff" },
    "blue": {
      "$type": "color",
      "50": { "$value": "#eef4fb" },
      "100": { "$value": "#d5e3f5" },
      "500": { "$value": "#3a74c4" },
      "700": { "$value": "#1d4f91" },
      "900": { "$value": "#0f2c55" }
    },
    "gray": {
      "$type": "color",
      "50": { "$value": "#f6f7f8" },
      "100": { "$value": "#e9ebee" },
      "300": { "$value": "#c4c9d0" },
      "500": { "$value": "#7b8491" },
      "700": { "$value": "#4a525e" },
      "900": { "$value": "#1c2129" }
    },
    "red": {
      "$type": "color",
      "50": { "$value": "#fdeeee" },
      "700": { "$value": "#b3261e" }
    },
    "green": {
      "$type": "color",
      "50": { "$value": "#ebf7ef" },
      "700": { "$value": "#1e6b3a" }
    },
    "orange": {
      "$type": "color",
      "50": { "$value": "#fff4e5" },
      "800": { "$value": "#8a4b00" }
    },
    "text": {
      "$type": "color",
      "default": { "$value": "{color.gray.900}", "$description": "Texte courant" },
      "muted": { "$value": "{color.gray.700}", "$description": "Texte secondaire, aides" },
      "inverse": { "$value": "{color.white}", "$description": "Texte sur fond foncé" },
      "link": { "$value": "{color.blue.700}", "$description": "Liens" },
      "error": { "$value": "{color.red.700}", "$description": "Message d'erreur de champ" },
      "success": { "$value": "{color.green.700}", "$description": "Confirmation courte" }
    },
    "background": {
      "$type": "color",
      "default": { "$value": "{color.white}", "$description": "Fond de page" },
      "subtle": { "$value": "{color.gray.50}", "$description": "Fond de bloc, de pied de page" },
      "inverse": { "$value": "{color.gray.900}", "$description": "Fond foncé" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{color.gray.300}", "$description": "Filets, séparateurs (décoratifs)" },
      "strong": { "$value": "{color.gray.500}", "$description": "Bordure de champ (contraste 3:1)" },
      "focus": { "$value": "{color.blue.700}", "$description": "Indicateur de focus" }
    },
    "action": {
      "$type": "color",
      "primary": { "$value": "{color.blue.700}", "$description": "Fond du bouton principal" },
      "primary-hover": { "$value": "{color.blue.900}", "$description": "Fond du bouton principal au survol" },
      "primary-text": { "$value": "{color.white}", "$description": "Texte du bouton principal" },
      "secondary-text": { "$value": "{color.blue.700}", "$description": "Texte du bouton secondaire" },
      "secondary-border": { "$value": "{color.blue.700}", "$description": "Bordure du bouton secondaire" },
      "disabled": { "$value": "{color.gray.100}", "$description": "Fond d'une action désactivée" },
      "disabled-text": { "$value": "{color.gray.700}", "$description": "Texte d'une action désactivée" }
    },
    "feedback": {
      "$type": "color",
      "error": {
        "text": { "$value": "{color.red.700}" },
        "background": { "$value": "{color.red.50}" },
        "border": { "$value": "{color.red.700}" }
      },
      "success": {
        "text": { "$value": "{color.green.700}" },
        "background": { "$value": "{color.green.50}" },
        "border": { "$value": "{color.green.700}" }
      },
      "warning": {
        "text": { "$value": "{color.orange.800}" },
        "background": { "$value": "{color.orange.50}" },
        "border": { "$value": "{color.orange.800}" }
      },
      "info": {
        "text": { "$value": "{color.blue.900}" },
        "background": { "$value": "{color.blue.50}" },
        "border": { "$value": "{color.blue.700}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Segoe UI", "system-ui", "-apple-system", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "heading": { "$value": "{font.family.base}" }
    },
    "size": {
      "$type": "dimension",
      "s": { "$value": "0.875rem" },
      "m": { "$value": "1rem" },
      "l": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" },
      "xxl": { "$value": "2rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "base": { "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "full": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": "44px", "$description": "Cible tactile minimale" },
    "focus-ring": { "$value": "3px", "$description": "Épaisseur de l'indicateur de focus" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "100ms" },
    "base": { "$value": "200ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "tablet": { "$value": "768px", "$description": "Écrit en dur dans les requêtes média des CSS de composants" },
    "desktop": { "$value": "1024px", "$description": "Écrit en dur dans les requêtes média des CSS de composants" }
  }
}
